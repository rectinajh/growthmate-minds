# ── Minds Builder API key (required) ──────────────────────────────────────
# 在 hellominds.ai → Builder console 创建；复制时仅显示一次。
MINDS_BUILDER_API_KEY=

# ── 目标 Mind（可选） ─────────────────────────────────────────────────────
# 留空则自动使用账号下的第一个 Mind。UUID 用 `npm run list` 查。
GROWTHMATE_MIND_ID=

# 对话别名（稳定复用同一段对话，保持记忆连续性）。
GROWTHMATE_ALIAS=growthmate-main

# ── 创作者人设（用于 prompt 插值，可选） ────────────────────────────────
CREATOR_NAME=我（创作者）
CREATOR_HANDLE=@creator
CREATOR_NICHE=生活方式 / 健身
REPLY_TONE=真诚、轻松、口语化，偶尔带一点点自嘲
REPLY_BOUNDARIES=不承诺做不到的事；不评价政治/宗教/身材；不透露隐私与后台数据
